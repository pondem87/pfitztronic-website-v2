import AboutSection from '../../components/about/AboutSection.astro';
import FeaturesSection from '../../components/features/FeaturesSection.astro';
import { approachFeatures } from '../../data/approach';
---
<PageLayout title="About" heroImage="/img/beautiful_people.jpg">
