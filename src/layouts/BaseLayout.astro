---
import Navigation from '../components/shared/Navigation.astro';
import Footer from '../components/shared/Footer.astro';
import Copyright from '../components/shared/Copyright.astro';
import Spinner from '../components/shared/Spinner.astro';
import BackToTop from '../components/shared/BackToTop.astro';
import { siteConfig } from '../config';
interface Props { title?: string; description?: string; }
const { title = 'Pfitztronic', description = 'We turn your vision into innovative solutions that inspire growth, create value, and drive lasting success.' } = Astro.props;
const pathname = Astro.url.pathname === '/404/' ? '/404.html' : Astro.url.pathname;
const canonical = new URL(pathname, siteConfig.origin).href;
const googleAnalyticsId = siteConfig.googleAnalyticsId;
---
<!DOCTYPE html>
<html lang={siteConfig.locale} data-site-country={siteConfig.countryCode} data-contact-form-endpoint={siteConfig.contactFormEndpoint}>
<head>
    <meta charset="utf-8">
    <title>{title}</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content={description} name="description">
    <link rel="canonical" href={canonical}>
    <link rel="alternate" hreflang={siteConfig.locale} href={canonical}>
    <link rel="alternate" hreflang={siteConfig.alternateLocale} href={new URL(pathname, siteConfig.alternateOrigin).href}>
    <link rel="alternate" hreflang="x-default" href={new URL(pathname, siteConfig.defaultOrigin).href}>
    <link rel="icon" type="image/png" sizes="100x100" href="/pfitz-icon.png">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans&family=Josefin+Sans:wght@600&family=Lora:ital@1&display=swap" rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="/lib/animate/animate.min.css" rel="stylesheet">
    <link href="/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">
    <link href="/css/boxup-carousel.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/css/style.css" rel="stylesheet">

  <script is:inline src="/js/ready.js"></script>
  <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}></script>
  <script is:inline define:vars={{ googleAnalyticsId }}>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', googleAnalyticsId);
  </script>
</head>
<body id="top" class="p-3 p-sm-4">
  <Spinner />
  <Navigation />
  <main><slot /></main>
  <Footer />
  <Copyright />
  <BackToTop />
<script is:inline defer src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.1/jquery.min.js"></script>
<script is:inline defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
<script is:inline defer src="/lib/wow/wow.min.js"></script>
<script is:inline defer src="/lib/easing/easing.min.js"></script>
<script is:inline defer src="/lib/waypoints/waypoints.min.js"></script>
<script is:inline defer src="/lib/owlcarousel/owl.carousel.min.js"></script>
<script is:inline defer src="/js/main.js"></script>
<script is:inline defer src="/js/contact-form.js"></script>
</body>
</html>
