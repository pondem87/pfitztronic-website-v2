---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';
import { formatBlogDate } from '../utils/blog';

interface Props { post: CollectionEntry<'blogs'>; }
const { post } = Astro.props;
const { data } = post;
---
<BaseLayout title={data.seoTitle ?? `${data.title} | Pfitztronic`} description={data.description}>
  <header class="container-fluid bg-dark rounded py-5 mt-4">
    <div class="container py-lg-4">
      <h1 class="display-5 text-white text-center mb-4">{data.title}</h1>
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog/' }, { label: data.title }]} />
    </div>
  </header>
  <div class="container-fluid bg-white rounded py-5 mt-4">
    <div class="container py-lg-4">
      <div class="row g-5">
        <article class="col-lg-8 pe-lg-5">
          <img src={data.image} alt={data.imageAlt} class="img-fluid w-100 rounded mb-4" />
          <div class="d-flex align-items-center mb-5">
            {data.authorImage && <img src={data.authorImage} alt={data.author} class="rounded-circle me-3" width="64" height="64" />}
            <div>
              <p class="h5 mb-1">{data.author}</p>
              <time datetime={data.published.toISOString()}>{formatBlogDate(data.published)}</time>
            </div>
          </div>
          <div class="blog-content"><slot /></div>
        </article>
        <aside class="col-lg-4">
          {data.authorBio && <div class="bg-light rounded p-4 mb-4">
            <h2 class="h3 mb-3">About the author</h2>
            <p class="mb-0">{data.authorBio}</p>
          </div>}
          {data.cta && <div class="bg-dark rounded p-4">
            <h2 class="h3 text-white mb-3">{data.cta.heading}</h2>
            <p class="text-white">{data.cta.text}</p>
            <a href="/contact/" class="btn btn-primary rounded-pill px-4 py-2">Contact Us</a>
          </div>}
          <a href="/blog/" class="d-block mt-4">← Back to all blog posts</a>
        </aside>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .blog-content { line-height: 1.8; overflow-wrap: anywhere; }
  .blog-content :global(h2), .blog-content :global(h3) { margin-top: 2.5rem; margin-bottom: 1rem; }
  .blog-content :global(p), .blog-content :global(ul), .blog-content :global(ol) { margin-bottom: 1.5rem; }
  .blog-content :global(li) { margin-bottom: .5rem; }
  .blog-content :global(blockquote) { border-left: 4px solid var(--bs-primary); padding: 1.5rem; background: var(--bs-light); }
  .blog-content :global(blockquote > :last-child) { margin-bottom: 0; }
  .blog-content :global(img) { max-width: 100%; height: auto; }
</style>
