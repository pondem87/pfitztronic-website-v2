---
import type { Testimonial } from '../../data/testimonials';
interface Props { item: Testimonial; index?: number; dark?: boolean; }
const { item, index = 0, dark = false } = Astro.props;
const delay = `${((index % 4) * 0.2 + 0.1).toFixed(1)}s`;
---
<div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay={delay}>
    <div class:list={["testimonial-item rounded h-100 p-4", dark ? "bg-black" : "bg-light"]}>
        <div class="d-flex align-items-center mb-3">
            <img class="img-fluid rounded flex-shrink-0 testimonial-img-sm" src={item.image} alt="">
            <div class="ps-3">
                <h5 class:list={["mb-0", { "text-white": dark }]}>{item.name}</h5>
                <span class={dark ? "text-white-50" : "text-black-50"}>{item.role}</span>
            </div>
        </div>
        <p class:list={["font-lora fs-5", { "text-white": dark }]}>{item.quote}</p>
        <div class="d-inline-flex">
            <i class="fa fa-star text-primary"></i>
            <i class="fa fa-star text-primary"></i>
            <i class="fa fa-star text-primary"></i>
            <i class="fa fa-star text-primary"></i>
            <i class="fa fa-star text-primary"></i>
        </div>
    </div>
</div>
