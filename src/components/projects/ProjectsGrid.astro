---
import SectionHeading from '../common/SectionHeading.astro';

interface Project { title: string; category: string; image: string; imageAlt: string; description?: string; href?: string; }
interface Props { projects: Project[]; eyebrow?: string; title?: string; }
const { projects, eyebrow = 'Projects', title = 'Selected Work' } = Astro.props;
---
<section class="container-fluid bg-white rounded py-5 mt-4">
  <div class="container py-4 py-lg-5">
    <SectionHeading {eyebrow} {title} />
    <ul class="row g-4 list-unstyled mb-0">
      {projects.map((project) => (
        <li class="col-md-6 col-xl-4">
          <article class="project-card rounded overflow-hidden h-100">
            {project.href ? <a href={project.href} class="project-image-link" aria-label={`View ${project.title}`}> <img src={project.image} alt={project.imageAlt} loading="lazy" /></a> : <img src={project.image} alt={project.imageAlt} loading="lazy" />}
            <div class="project-caption p-4">
              <p class="font-lora text-primary mb-1">{project.category}</p>
              <h3 class="h4 mb-0">{project.href ? <a href={project.href}>{project.title}</a> : project.title}</h3>
              {project.description && <p class="mt-3 mb-0">{project.description}</p>}
              {project.href && <a class="btn btn-primary rounded-pill mt-4 px-4 py-2" href={project.href}>Explore {project.title}</a>}
            </div>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .project-card { background: var(--bs-light); }
  .project-card > img, .project-image-link img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; transition: transform .35s ease; }
  .project-image-link { display: block; overflow: hidden; }
  .project-image-link:hover img { transform: scale(1.04); }
  .project-caption { border: 1px solid var(--bs-border-color); border-top: 0; border-radius: 0 0 var(--bs-border-radius) var(--bs-border-radius); }
  @media (prefers-reduced-motion: reduce) { .project-card img { transition: none; } }
</style>
