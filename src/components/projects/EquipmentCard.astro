---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  name: string;
  category: string;
  description: string;
  image: ImageMetadata;
  alt: string;
}

const { name, category, description, image, alt } = Astro.props;
const maxWidth = Math.min(image.width, 960);
const widths = [...new Set([320, 640, maxWidth])].filter((width) => width <= maxWidth).sort((a, b) => a - b);
---

<article class="equipment-card">
  <div class="equipment-image">
    <Image
      src={image}
      alt={alt}
      widths={widths}
      sizes="(min-width: 1200px) 480px, (min-width: 768px) 360px, 90vw"
      width={maxWidth}
      format="webp"
      quality={85}
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="equipment-copy">
    <p class="equipment-category">{category}</p>
    <h3>{name}</h3>
    <p class="equipment-description">{description}</p>
  </div>
</article>

<style>
  .equipment-card { min-width: 0; }
  .equipment-image {
    display: grid;
    place-items: center;
    height: 300px;
    padding: 28px;
    background: #fff;
    border: 1px solid #e4e9ed;
    border-radius: 8px;
  }
  .equipment-image img { display: block; width: 100%; height: 100%; min-height: 0; object-fit: contain; }
  .equipment-copy { padding: 28px 4px 0; }
  .equipment-category { margin: 0 0 10px; color: var(--bs-primary); font-size: .72rem; letter-spacing: .09em; font-weight: 600; text-transform: uppercase; }
  h3 { color: var(--bs-dark); font-size: 1.4rem; line-height: 1.35; margin: 0 0 14px; }
  .equipment-description { color: #536575; font-size: .95rem; line-height: 1.85; margin: 0; max-width: 48ch; }
  @media (max-width: 991px) { .equipment-image { height: 260px; padding: 24px; } }
  @media (max-width: 575px) { .equipment-image { height: 280px; } }
</style>
