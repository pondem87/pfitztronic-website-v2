---
import SectionHeading from '../common/SectionHeading.astro';

interface Question { question: string; answer: string; }
interface Props { questions: Question[]; eyebrow?: string; title?: string; }
const { questions, eyebrow = 'FAQs', title = 'Frequently Asked Questions' } = Astro.props;
---
<section class="container-fluid bg-white rounded py-5 mt-4">
  <div class="container py-4 py-lg-5">
    <SectionHeading {eyebrow} {title} />
    <div class="row justify-content-center">
      <div class="col-lg-9">
        <div class="faq-list">
          {questions.map((item, index) => (
            <details class="faq-item bg-light rounded mb-3" open={index === 0}>
              <summary>{item.question}</summary>
              <div class="faq-answer"><p class="mb-0">{item.answer}</p></div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .faq-item { border: 1px solid var(--bs-border-color); padding: 1.25rem 1.5rem; }
  .faq-item summary { position: relative; padding-right: 2rem; cursor: pointer; color: var(--bs-dark); font: 600 1.125rem/1.4 'Josefin Sans', sans-serif; list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; position: absolute; top: 0; right: 0; color: var(--bs-primary); font: 600 1.5rem/1 'Open Sans', sans-serif; }
  .faq-item[open] summary::after { content: '−'; }
  .faq-answer { padding-top: 1rem; }
</style>
