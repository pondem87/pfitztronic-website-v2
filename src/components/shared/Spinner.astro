<div id="spinner" class="bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex flex-column align-items-center justify-content-center">
    <span class="spinner-border text-primary mb-2" role="status" style="width: 3rem; height: 3rem;"></span>
    <span role="status">Loading...</span>
</div>

<script is:inline>
    document.getElementById('spinner')?.classList.add('show');
    window.setTimeout(() => document.getElementById('spinner')?.classList.remove('show'), 3000);
</script>
