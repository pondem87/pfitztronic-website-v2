---
import ContactForm from '../contact/ContactForm.astro';
import ContactInformation from './ContactInformation.astro';
---
<div class="container-fluid bg-white rounded py-5 mt-4">
    <div class="container py-5">
        <div class="row g-4">
            <ContactInformation />
            <div class="col-lg-6 wow fadeInUp" data-wow-delay="0.5s">
                <div class="contact-form bg-light rounded h-100 p-4">
                    <img class="contact-form-image img-fluid rounded mb-4" src="/img/contact-us.jpg" alt="A business consultant discussing a project with a client">
                    <h1 class="display-5 mb-4">Contact Us</h1>
                    <ContactForm idPrefix="contact" />
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .contact-form-image {
        display: block;
        width: 100%;
        height: 13rem;
        object-fit: cover;
        object-position: center 30%;
    }
</style>
