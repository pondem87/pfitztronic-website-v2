---
import { siteConfig } from '../../config';
interface Props { dark?: boolean; idPrefix: string; }
const { dark = false, idPrefix } = Astro.props;
---
<form class="js-contact-form" method="post">
    <fieldset class="row g-3">
        <legend class="visually-hidden">Contact Pfitztronic</legend>
        <div class="col-sm-6 control-group">
            <div class="form-floating">
                <input type="text" class:list={["form-control border-0", { "bg-black": dark }]} id={`${idPrefix}-name`} name="name" placeholder="Your Name" autocomplete="name" maxlength="120" required />
                <label for={`${idPrefix}-name`}>Your Name</label>
            </div>
            <p class="help-block text-danger"></p>
        </div>
        <div class="col-sm-6 control-group">
            <div class="form-floating">
                <input type="email" class:list={["form-control border-0", { "bg-black": dark }]} id={`${idPrefix}-email`} name="email" placeholder="Your Email" autocomplete="email" maxlength="254" required />
                <label for={`${idPrefix}-email`}>Your Email</label>
            </div>
            <p class="help-block text-danger"></p>
        </div>
        <div class="col-sm-6 control-group">
            <div class="form-floating">
                <input type="tel" class:list={["form-control border-0", { "bg-black": dark }]} id={`${idPrefix}-mobile`} name="mobile" placeholder="Mobile" autocomplete="tel" maxlength="32" required />
                <label for={`${idPrefix}-mobile`}>Mobile</label>
            </div>
            <p class="help-block text-danger"></p>
        </div>
        <div class="col-sm-6 control-group">
            <div class="form-floating">
                <input type="text" class:list={["form-control border-0", { "bg-black": dark }]} id={`${idPrefix}-subject`} name="subject" placeholder="Subject" maxlength="200" required />
                <label for={`${idPrefix}-subject`}>Subject</label>
            </div>
            <p class="help-block text-danger"></p>
        </div>
        <div class="col-12 control-group">
            <div class="form-floating">
                <textarea style="height: 165px" class:list={["form-control border-0", { "bg-black": dark }]} id={`${idPrefix}-message`} name="message" placeholder="Message" maxlength="10000" required></textarea>
                <label for={`${idPrefix}-message`}>Leave a message here</label>
            </div>
            <p class="help-block text-danger"></p>
        </div>
        <div class="col-12">
            <button class="btn btn-primary w-100 py-3" type="submit" id={`${idPrefix}-send`} disabled>
                <span>Send Message</span>
                <span class="d-none spinner-border spinner-border-sm text-light ms-3" role="status" aria-label="Sending"></span>
            </button>
        </div>
    </fieldset>
    <p class="small mt-3 mb-0">We use your details to respond to your enquiry. Read our <a href="/privacy/">Privacy Policy</a>.</p>
    <p class="js-contact-status mt-3 mb-0" role="status" aria-live="polite"></p>
    <p class="small mt-2 mb-0">You can also email <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>.</p>
    <noscript><p class="mt-3">Please use the email link above to send your enquiry.</p></noscript>
</form>
